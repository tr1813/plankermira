survey iah -title "Ice-Age-Höhle"

input "./1-Eingang/Eingang.th"
input "./2-EukalyptusLabyrinth/EukalyptusLabyrinth.th"

map m-all-p -projection plan 
    m-all-p@1
    m-all-p@2
endmap

map m-all-e -projection extended 
    m-all-e@1
    m-all-e@2
endmap

centreline 
cs epsg:32633
#fix 0@1 502216 277232 2030 # MGI Austria GK31
#fix 0@1 47.6317137 14.0273618 2030 (lat-long)
fix 0@1 426931 5275826 2030 #(UTM 33N)

equate 56@1 0@2
	
endcentreline

#input "../DEM/512287_clipped.th"

endsurvey